// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

//what clients should be generated based on the data model (e.g. Prisma Client)
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

//details of the data sources Prisma ORM should connect to (e.g. a PostgreSQL database)
datasource db {
  provider = "postgresql"
}



model User {
  uid         Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  email       String   @unique
  uname       String?
  role        Role     @default(USER)
  projects    Project[]
}
model Project {
  pid       Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pname     String   @db.VarChar(255)
  status    ProjectStatus[]
  user      User  @relation(fields: [userId], references:[uid])
  userId    Int 
}
model Item {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(255)
  quantity     Int
  costEstimate Decimal
  status       ItemStatus[]
}
enum Role {
  USER
  VENDOR
}
enum ProjectStatus {
  Design
  Sourcing
  Prep
  Install
  Done
}
enum ItemStatus {
  Needed
  Ordered
  Delivered
  Installed
}